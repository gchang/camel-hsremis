       INTEGER, PARAMETER :: nb_lons=7200
       INTEGER, PARAMETER :: max_npcs=44
       INTEGER, PARAMETER :: nb_pcs=9
       INTEGER, PARAMETER :: max_nmask = nb_lats*nb_lons/2 
      
